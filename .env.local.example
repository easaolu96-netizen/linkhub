# ------------------------------------------------------------------
# LinkHub environment variables
# Copy this file to `.env.local` and fill in the values:
#   cp .env.local.example .env.local      (macOS/Linux/Git Bash)
#   copy .env.local.example .env.local    (Windows cmd/PowerShell)
# Never commit .env.local — it is already in .gitignore.
# ------------------------------------------------------------------

# Public base URL of the site (no trailing slash).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (or "Connect" button)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" key (newer dashboards call it the "publishable" key, sb_publishable_...).
# Safe to expose in the browser — Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key (newer dashboards: "secret" key, sb_secret_...).
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import it in client components, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured inside the Supabase dashboard
# (Authentication → Providers → Google), so no Google keys are needed here.
